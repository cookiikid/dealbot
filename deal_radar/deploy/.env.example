# =============================================================================
#  DealRadar environment — copy to the repository root as `.env` and fill in.
#  Every value is optional unless noted; unset sources/targets are simply disabled.
#  Docker:   docker compose --env-file .env -f deal_radar/deploy/docker-compose.yml up -d
#  Bare:     python -m deal_radar.main   (reads ./.env automatically)
# =============================================================================

# ---- node identity -----------------------------------------------------------
NODE_ID=gcp-primary
APP_ROLES=collector,processor          # home laptop: collector
APP_TIMEZONE=America/New_York
LOG_LEVEL=INFO
LOG_JSON=true
DRY_RUN=false

# ---- state -------------------------------------------------------------------
REDIS_PASSWORD=change-me-to-a-long-random-string     # required by docker-compose (Valkey)
# REDIS_URL is set by docker-compose for the primary. Bare-metal example:
# REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# BUS_BACKEND=redis
# Laptop collector -> primary Valkey over Tailscale:
# PRIMARY_REDIS_URL=redis://:change-me@100.101.102.103:6379/0
# DATABASE_URL=postgresql+asyncpg://dealradar:pass@127.0.0.1:5432/dealradar
HTTP_AUTH_TOKEN=change-me-too           # protects /status, /alerts/recent and /ws

# ---- your location (local marketplaces, eBay delivery estimates) -------------
HOME_ZIP=10001
HOME_LAT=40.7128
HOME_LON=-74.0060
FB_CITY_SLUG=nyc
FB_RADIUS_KM=60

# ---- sources -----------------------------------------------------------------
EBAY_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

REDDIT_ENABLED=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

SLICKDEALS_ENABLED=true

RETAIL_ENABLED=false
BESTBUY_API_KEY=

FB_ENABLED=false                        # enable on the laptop node only
FB_NODES=home-laptop
FB_HEADLESS=true
FB_STORAGE_STATE=data/fb_storage_state.json
FB_PROXY=

OFFERUP_ENABLED=false
CRAIGSLIST_ENABLED=false

# ---- local GPU vision (RTX 3060 desktop, over Tailscale) -----------------------
VISION_ENABLED=false
VISION_BACKEND=ollama
VISION_URL=http://100.64.0.10:11434
VISION_MODEL=qwen3-vl:4b-instruct
VISION_ESCALATION_MODEL=qwen3-vl:8b-instruct
OLLAMA_BIND=100.64.0.10

# ---- alert channels ------------------------------------------------------------
DISCORD_WEBHOOK_PRICE_ERRORS=
DISCORD_WEBHOOK_GPU=
DISCORD_WEBHOOK_DISPLAYS=
DISCORD_WEBHOOK_GENERAL=
DISCORD_WEBHOOK_OPS=
DISCORD_ROLE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
